<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
		<!-- Uncomment to also build the tizen app. You will need to install tizen by following this: https://github.com/Samsung/Tizen.NET -->
		<!-- <TargetFrameworks>$(TargetFrameworks);net8.0-tizen</TargetFrameworks> -->

    <!-- Force Windows x64 so Visual Studio and VSCode run the same bitness -->
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win10-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>

    <OutputType>Exe</OutputType>
    <RootNamespace>PRG_MAUI_Car_Register</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Display name -->
    <ApplicationTitle>PRG_MAUI_Car_Register</ApplicationTitle>

    <!-- App Identifier -->
    <ApplicationId>com.companyname.prgmauicarregister</ApplicationId>

    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- Windows target -->
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>

    <!-- Ensure NuGet restore runs when building from IDE if missing -->
    <RestoreDuringBuild>true</RestoreDuringBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- App Icon -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

    <!-- Splash Screen -->
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

    <!-- Images -->
    <MauiImage Include="Resources\Images\*" />
    <MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />

    <!-- Custom Fonts -->
    <MauiFont Include="Resources\Fonts\*" />

    <!-- Raw Assets -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="9.0.110" />
    <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="9.0.110" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.9" />
  </ItemGroup>

  <!-- Exclude Windows App SDK auto-initializers to avoid early WinRT activation
       (use this only if you do not rely on Windows App SDK native runtime features) -->
  <ItemGroup>
    <Compile Remove="**\WindowsAppRuntimeAutoInitializer.cs" />
    <Compile Remove="**\DeploymentManagerAutoInitializer.cs" />
    <Compile Remove="**\UndockedRegFreeWinRTCS.AutoInitializer.cs" />
    <Compile Remove="**\WindowsAppRuntime.*AutoInitializer.cs" />
  </ItemGroup>

  <!-- Ensure a restore runs before build so project.assets.json is generated when missing -->
  <Target Name="EnsureDotnetRestore" BeforeTargets="PrepareForBuild">
    <Message Importance="high" Text="Running dotnet restore for $(MSBuildProjectName)" />
    <Exec Command="dotnet restore &quot;$(MSBuildProjectFullPath)&quot;" ContinueOnError="false" />
  </Target>

  <!-- Remove Windows App Runtime projection/bootstrap DLLs from output so the projection won't attempt WinRT activation at startup -->
  <ItemGroup>
    <FilesToRemove Include="$(OutDir)Microsoft.Windows.ApplicationModel.WindowsAppRuntime.Projection.dll" />
    <FilesToRemove Include="$(OutDir)Microsoft.WindowsAppRuntime.Bootstrap.dll" />
    <FilesToRemove Include="$(OutDir)Microsoft.WindowsAppRuntime.Bootstrap.Net.dll" />
    <FilesToRemove Include="$(OutDir)Microsoft.WindowsAppRuntime.Native.dll" />
  </ItemGroup>

  <Target Name="RemoveWindowsAppRuntimeFiles" AfterTargets="Build">
    <Message Importance="high" Text="Removing Windows App Runtime projection/bootstrap DLLs from output to avoid WinRT activation on machines without the native runtime" />
    <Delete Files="@(FilesToRemove)" ContinueOnError="true" />
  </Target>

</Project>
